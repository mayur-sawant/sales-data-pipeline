# Copy to .env and adjust. Relative paths are resolved against the project root.
RAW_DATA_PATH=data/raw/sales_data.csv
PROCESSED_DATA_PATH=data/processed
REPORTS_PATH=data/reports
LOG_DIR=logs
LOG_LEVEL=INFO

# Spark
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=4
SPARK_LOG_LEVEL=ERROR

# CSV writer: auto | spark | local
#   auto  -> native Spark writer when supported, otherwise streaming local writer
#   spark -> requires HADOOP_HOME with bin\winutils.exe on Windows
OUTPUT_WRITE_MODE=auto

# Optional: point to a JDK 17/21 if it is not already set system-wide
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.x-hotspot
